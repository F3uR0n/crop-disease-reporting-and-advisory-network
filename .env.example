# Copy to .env (never commit .env) or set these as system environment variables.

# MySQL
DB_URL=jdbc:mysql://localhost:3306/crop_disease?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# First admin account (created on startup only if no admin exists)
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=change-me-too

# LLM provider (vision-capable model for diagnosis + chat model for the chatbot)
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=your-api-key
AI_VISION_MODEL=model-name
AI_CHAT_MODEL=model-name
